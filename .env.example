# === LLM Models ===
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-...
EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings

# === Paths ===
VAULT_PATH=./vault
DB_PATH=./mcp-server/nova.db

# === Search tuning ===
SIMILARITY_THRESHOLD=0.75
FUSION_THRESHOLD=0.9
SEARCH_RESULTS_DEFAULT=10
KEYWORD_WEIGHT=0.3
SEMANTIC_WEIGHT=0.6
GRAPH_WEIGHT=0.0

# === MCP response levels ===
SUMMARY_MAX_TOKENS=80
STANDARD_PREVIEW_TOKENS=200
COMPLETE_GRAVITY_HOPS=1

# === Git ===
AUTO_COMMIT_INTERVAL=30

# === Indexer ===
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# === Health check ===
ORPHAN_ALERT_DAYS=7
STALE_DRAFT_DAYS=30
CONSTELLATION_MAX_STARS=35
CONSTELLATION_MIN_CLUSTER=5
CONSTELLATION_MIN_CLUSTER_RATIO=0.005
